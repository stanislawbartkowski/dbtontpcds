# Copy to .env, fill in real values, then `source .env` before running dbt.
# .env is gitignored — never commit real credentials.

# -----------------------------
# Databricks Unity Catalog
# -----------------------------

# Workspace hostname, without https://
export DBT_DATABRICKS_HOST=<workspace-host>
export DBT_DATABRICKS_TOKEN=<personal-access-token>

export DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Unity Catalog configuration
export DBT_CATALOG=main
export DBT_SCHEMA=tpc

export RESULT_SIZE=10
export DBT_TARGET=dev_databricks
export SQL_ENGINE_DESCRIPTION="Warehouse serverless cluster (Cluster size = Medium)"

# -------------------------------
# Postgresql
# -------------------------------

# HOST, USER, PASSWORD, SCHEMA required; PORT and DBNAME optional
# (default to 5432 and tpc_data)
export DBT_POSTGRES_HOST=<host>
export DBT_POSTGRES_USER=<user>
export DBT_POSTGRES_PASSWORD=<password>
export DBT_POSTGRES_DBNAME=tpc_data
export DBT_POSTGRES_SCHEMA=public

export RESULT_SIZE=1
export DBT_TARGET=dev_postgres
export SQL_ENGINE_DESCRIPTION="Standalone Postgres <version>, <linux distro/version>, <CPU model> (<N> vCPU) / <RAM>GB RAM"

# -------------------------------
# Spark Connect
# -------------------------------

# All optional - a local Spark Connect server needs none of this set
# (defaults shown)
export DBT_SPARK_HOST=localhost
export DBT_SPARK_SCHEMA=default
export DBT_SPARK_REMOTE=sc://localhost:15002

export RESULT_SIZE=1
export DBT_TARGET=dev_spark
export SQL_ENGINE_DESCRIPTION="Local Spark Connect session"
